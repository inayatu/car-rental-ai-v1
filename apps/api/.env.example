NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of front-end origins, e.g. http://localhost:5173,https://gbtrip.pk,https://www.gbtrip.pk
# In development, omit this to allow any http(s) from localhost/127.0.0.1
CORS_ORIGIN=

# Option A: full Mongo URI (recommended for cloud/managed Mongo)
MONGO_URI=

# Option B: compose Mongo URI from credentials (used when MONGO_URI is empty)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB_NAME=car_rental_ai
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Connection pool/timeouts for scalability
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

JWT_ACCESS_SECRET=replace_with_min_16_char_secret
JWT_REFRESH_SECRET=replace_with_min_16_char_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Local upload storage
UPLOADS_DIR=uploads
UPLOADS_PUBLIC_BASE_PATH=/uploads
IMAGE_MAX_WIDTH=1920
IMAGE_QUALITY=82
UPLOAD_MAX_SIZE_MB=10
